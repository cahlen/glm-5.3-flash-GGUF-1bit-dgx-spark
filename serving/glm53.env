# ============================================================================
# GLM-5.3-Flash serving configuration for the DGX Spark (GB10, 119 GiB unified)
#
# Read by serving/glm53-up.sh, which is what glm53.service execs. Change a value
# here, then:   systemctl --user restart glm53
#
# Provenance of the running stack (keep these in sync with what is deployed):
#   llama.cpp : https://github.com/unslothai/llama.cpp
#               branch glm5next/upstream, commit d07e71e ("Add MTP support")
#   model     : unsloth/GLM-5.3-Flash-GGUF, UD-IQ1_S (3 shards, 86.7 GiB)
#               arch glm5next, 46 blocks, 288 experts, nextn_predict_layers=1
# ============================================================================

GLM53_BIN=${HOME}/llama.cpp-glm5/build/bin/llama-server
GLM53_MODEL=${HOME}/models/GLM-5.3-Flash-UD-IQ1_S/UD-IQ1_S/GLM-5.3-Flash-UD-IQ1_S-00001-of-00003.gguf
GLM53_ALIAS=glm-5.3-flash

GLM53_HOST=0.0.0.0
GLM53_PORT=8090

# ---- context -------------------------------------------------------------
# 131072 is affordable here because this architecture barely uses KV: only 12 of
# the 46 blocks carry attention KV heads (head_count_kv is a per-layer array that
# is 0 for 34 of them — those are linear-attention layers with a fixed-size
# recurrent state that does NOT grow with context). Measured cost of KV:
#     49152 @ f16  = 1.2 GiB      131072 @ q8_0 = 1.7 GiB
#    131072 @ f16  = 3.1 GiB      262144 @ q8_0 = 3.3 GiB
# So raising 49K -> 128K costs about half a gibibyte. Context is not what is
# tight on this box; the 86.7 GiB of weights is.
GLM53_CTX=131072
GLM53_PARALLEL=1

# ---- GPU / memory --------------------------------------------------------
GLM53_NGL=999
# q8_0 KV roughly halves the cache versus f16 at no measurable quality cost for
# this workload. Allowed: f32 f16 bf16 q8_0 q5_1 q5_0 iq4_nl q4_1 q4_0
GLM53_CACHE_TYPE_K=q8_0
GLM53_CACHE_TYPE_V=q8_0
GLM53_FLASH_ATTN=on
# Compute buffers scale with ubatch. 512 costs ~3.4 GiB here; drop to 256 to buy
# back ~1.2 GiB of headroom at some prompt-processing throughput.
GLM53_UBATCH=512
GLM53_BATCH=2048

# ---- MTP / speculative decoding ------------------------------------------
# GLM-5.3-Flash ships its NextN/MTP head inside the SAME GGUF
# (nextn_predict_layers=1). `--spec-type draft-mtp` and NOTHING ELSE loads those
# heads into the already-resident trunk (+2.79 GiB, measured).
#
# NEVER set --spec-draft-model/-md. Pointing it at the full GGUF loads a SECOND
# complete copy of the weights (86.7 GiB x2 against 119 GiB) and hard-locks the
# box. That happened 2026-08-30; see ~/glm53-crash-stream.log.
#
# Set GLM53_SPEC_TYPE=none to disable MTP (used by the mtp_sweep bench).
GLM53_SPEC_TYPE=draft-mtp
# Depth 2, not the llama.cpp default of 3. Measured on this box with
# serving/mtp-sweep.sh (2026-08-31, UD-IQ1_S @128K q8 KV, 3 reps x 4 workloads):
#
#   arm     decode   vs off   acceptance | code  diff  prose  json
#   off     18.73    1.00x        n/a    | 18.7  18.7   18.7  18.7
#   n1      24.84    1.33x      0.766    | 25.2  24.7   22.4  25.1
#   n2      27.75    1.48x      0.640    | 28.6  27.9   23.3  27.6   <-- best
#   n3      26.20    1.40x      0.500    | 26.7  26.0   20.3  26.8
#   n4      25.89    1.38x      0.455    | 29.8  26.6   18.7  26.4
#   n5      24.00    1.28x      0.376    | 27.1  22.8   16.2  24.7
#
# Acceptance falls faster than depth buys tokens. By n4-n5 the prose column is
# AT OR BELOW the no-MTP baseline (18.7 / 16.2 vs 18.73): the wasted draft
# compute costs more than the speculation saves. Re-run the sweep if the model,
# quant or llama.cpp commit changes — the optimum is specific to all three.
GLM53_SPEC_DRAFT_N_MAX=2
GLM53_SPEC_DRAFT_N_MIN=0

# ---- sampling ------------------------------------------------------------
# Unsloth's run guide for THIS GGUF (unsloth.ai/docs/models/glm-5.3-flash,
# "Recommended Settings", Default / Most Tasks):
#     temperature = 1.0   top_p = 0.95
# Its DeepSWE column (temperature 0.95, top_p 1.0) is a SWE-agent harness
# setting, not the general recommendation.
#
# Do not be tempted by the top_p=1.0 in the base model card's benchmark
# footnotes: those are zai-org's eval settings for full-precision
# GLM-5.3-Flash, not guidance for the quantized GGUF.
#
# Confirmed by measurement on THIS quant (2026-08-31, 5 trials/scenario, same
# server, only top_p varied):
#     scenario 08 (long system prompt + required tool call)
#         top_p 1.0  -> 1/5   duplicate run_shell calls
#         top_p 0.95 -> 5/5
#     scenario 06 unchanged (3/5 both) — that failure is not sampling-related.
# top_p 1.0 measurably costs tool-call reliability here.
GLM53_TEMP=1.0
GLM53_TOP_P=0.95

# ---- reasoning -----------------------------------------------------------
# The GLM-5.3 chat template accepts reasoning_effort of ONLY 'low' or 'high':
#     effective_reasoning_effort = reasoning_effort in ['low','high'] ? it : 'max'
# Any other value — including the literal "max" — falls through to 'max'. So
# leaving this EMPTY is what gives you Max, which is the right default for
# autonomous/agentic operation. Do not set this to 'low' globally: that is what
# the OpenCode config was doing, and it starves the model of reasoning on exactly
# the planning and tool-selection turns that need it most.
#
# Per-request override (this is how a client asks for cheap reasoning on a long
# straight code-emission turn, without changing the server default):
#     "chat_template_kwargs": {"reasoning_effort": "low"}
GLM53_REASONING_EFFORT=

# on  -> --reasoning-preserve   -> template clear_thinking=false
#        every assistant turn keeps its <think> block in the replayed history
# off -> --no-reasoning-preserve -> template clear_thinking=true
#        only turns after the last user message keep reasoning; older ones are
#        replaced with <think></think>, which is much cheaper on a long agent run
# 'on' is the current, known-working behaviour. Flip to 'off' if long OpenCode
# sessions start running out of context.
GLM53_REASONING_PRESERVE=on

# How thoughts come back to the client. 'deepseek' puts them in
# message.reasoning_content (what OpenCode's reasoning:true expects); 'none'
# leaves them inline in message.content.
GLM53_REASONING_FORMAT=deepseek

# ---- misc ----------------------------------------------------------------
# preflight refuses to start when MemFree is low or another >8 GiB process is
# resident. Useful before a MANUAL launch; wrong for the service, where a
# refusal to restart is just a longer outage (systemd already guarantees a
# single instance). 1 to enable.
GLM53_PREFLIGHT=0
# Anything extra, appended verbatim to the command line.
GLM53_EXTRA=
